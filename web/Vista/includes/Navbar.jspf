<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<nav class="navbar navbar-expand-md navbar-punto py-3 shadow-sm">
    <div class="container">
        <!-- Logo y marca -->
        <a class="navbar-brand d-flex align-items-center fw-bold" href="${pageContext.request.contextPath}/Vista/index.jsp">
            <i class="bi bi-box-seam me-2 fs-4 text-primary"></i>
            <span>Punto Cajas</span>
        </a>

        <!-- Botón responsive para dispositivos móviles -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Enlaces de navegación -->
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item">
                    <a class="nav-link" href="${pageContext.request.contextPath}/Vista/index.jsp">Inicio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="${pageContext.request.contextPath}/Vista/cotizar.jsp">Cotizar</a>
                </li>
                
                <!-- Opciones según el estado de la sesión -->
                <c:choose>
                    <c:when test="${not empty sessionScope.usuarioActivo}">
                        <li class="nav-item">
                            <a class="nav-link" href="${pageContext.request.contextPath}/Vista/MisCotizaciones.jsp">Mis Cotizaciones</a>
                        </li>
                        
                        <c:if test="${sessionScope.usuarioActivo.rol == 'Administrador'}">
                            <li class="nav-item">
                                <a class="nav-link" href="${pageContext.request.contextPath}/Vista/GestionarCotizaciones.jsp">Gestionar</a>
                            </li>
                        </c:if>

                        <li class="nav-item dropdown ms-md-3">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-1"></i> ${sessionScope.usuarioActivo.nombre}
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                                <li><a class="dropdown-item" href="${pageContext.request.contextPath}/Vista/perfil.jsp">Mi Perfil</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="${pageContext.request.contextPath}/CerrarSesionServlet">Cerrar Sesión</a></li>
                            </ul>
                        </li>
                    </c:when>
                    <c:otherwise>
                        <li class="nav-item ms-md-2">
                            <a class="btn btn-outline-primary btn-sm px-3 me-2" href="${pageContext.request.contextPath}/Vista/login.jsp">Iniciar Sesión</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm px-3" href="${pageContext.request.contextPath}/Vista/registro.jsp">Registrarse</a>
                        </li>
                    </c:otherwise>
                </c:choose>
            </ul>
        </div>
    </div>
</nav>